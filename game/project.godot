; LEGO Supersonic RC - native port
config_version=5

[application]

config/name="Supersonic RC"
config/description="Native port of LEGO Supersonic RC (2003) by catsandsoup."
config/version="0.1.0"
run/main_scene="res://main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Supersonic RC"
config/features=PackedStringArray("4.7")
config/icon="res://icon.png"
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 1)
run/max_fps=0

[display]

window/size/viewport_width=640
window/size/viewport_height=480
window/size/window_width_override=1440
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1
window/dpi/allow_hidpi=true

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=16
common/physics_interpolation=true
3d/default_gravity=9.81

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=2
textures/default_filters/anisotropic_filtering_level=4
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3

[autoload]

TestDriver="*res://tools/test_driver.gd"
