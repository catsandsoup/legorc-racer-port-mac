[configuration]

entry_symbol = "supersonic_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

macos.debug = "res://bin/libsupersonic.macos.template_debug.framework"
macos.release = "res://bin/libsupersonic.macos.template_release.framework"
linux.debug.x86_64 = "res://bin/libsupersonic.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libsupersonic.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/libsupersonic.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/libsupersonic.linux.template_release.arm64.so"
windows.debug.x86_64 = "res://bin/libsupersonic.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libsupersonic.windows.template_release.x86_64.dll"
